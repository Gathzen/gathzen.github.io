---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { getProject } from '../../data/projects';

const project = getProject('paper-prototypes');
---

<ProjectLayout project={project!}>
  <h2>Paper prototypes and GGDs</h2>
  <h2>Smaller paper projects and Game Design Documents</h2>
  <h3>Cat Cafe</h3>
  <p>This was a board game that I designed in a team for a class while at Uppsala University. For this project we had to follow the MDA method of game design.</p>
  <p>It’s a cooperation game were you play as cats in a cat cafe and you need to satisfy as many customers as possible.</p>
  <img
    src="/images/paper-prototypes/01.webp"
    alt="Prototypes and GGDs image 1"
    width="1920"
    height="1357"
    class="w-full"
  />
  <img
    src="/images/paper-prototypes/02.webp"
    alt="Prototypes and GGDs image 2"
    width="550"
    height="778"
    class="w-full"
  />
  <p>Cheat-sheet to give out to the players for all the cats&#x27; statistics</p>
  <img
    src="/images/paper-prototypes/03.webp"
    alt="Prototypes and GGDs image 3"
