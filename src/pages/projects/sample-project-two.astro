---
import ProjectLayout from '../../components/ProjectLayout.astro';
import { getProject } from '../../data/projects';

const project = getProject('sample-project-two');
---

<ProjectLayout project={project!}>
  <p>
    Write the story of this project here — the problem, your approach, and what
    you built. Replace this placeholder text.
  </p>

  <h2>Screenshots</h2>
  <img
    src="/images/placeholder-screenshot.svg"
    alt="Sample Project Two screenshot"
    width="1280"
    height="720"
  />

  <h2>What I learned</h2>
  <p>Replace with takeaways, tech used, team size, timeline, etc.</p>
</ProjectLayout>