---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Homepage tiles under the lead project use the smaller title. */
  size?: 'large' | 'small';
}

const { project, size = 'large' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a href={`${base}projects/${project.slug}/`} class="group relative block overflow-hidden no-underline">
  <img
    src={project.thumbnail}
    alt=""
    width="640"
    height="360"
    class="aspect-video w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-105 motion-safe:group-focus-visible:scale-105"
  />
  <div
    class:list={[
      'absolute inset-0 flex flex-col items-center justify-center px-12 text-center text-white opacity-0 transition-opacity duration-300',
      'group-hover:opacity-100 group-focus-visible:opacity-100',
      '[@media(hover:none)]:hidden',
    ]}
  >
    <div
      class:list={[
        'absolute inset-0',
        project.light
          ? 'bg-[linear-gradient(45deg,#2a0348_24%,#00075c_60%,#4e0046_93%)] opacity-[0.78]'
          : 'bg-[linear-gradient(45deg,#6507b9_24%,#001ce3_60%,#e300c7_93%)] opacity-[0.44]',
      ]}
    >
    </div>
    <div
      class="relative flex w-full max-w-[600px] flex-col items-center motion-safe:translate-y-3 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:group-hover:translate-y-0 motion-safe:group-focus-visible:translate-y-0"
    >
      <h2
        class:list={[
          'w-fit max-w-full bg-white px-3 py-1 text-[32.4px] leading-[1.2] text-[#6923ae]',
          size === 'large' && 'sm:text-[48.6px]',
        ]}
      >
        {project.title}
      </h2>
      <p class="mt-4 max-w-full">{project.summary}</p>
    </div>
  </div>
  <h2 class="mt-3 leading-[1.2] [@media(hover:hover)]:hidden">{project.title}</h2>
</a>
