---
import '../styles/global.css';

interface Props {
  /** Page title — rendered in <title> and used by the top bar. */
  title: string;
  description?: string;
}

const { title, description = 'Personal portfolio' } = Astro.props;

const base = import.meta.env.BASE_URL;
const siteName = 'Nathaniel “Ash” Sherman';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=LINE+Seed+JP:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="bg-black px-6 py-4">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 text-[#d579ff] [&_a]:text-[#d579ff] [&_a]:no-underline [&_a]:hover:text-[#ff79e6] [&_a]:focus-visible:text-[#ff79e6]">
        <a href={base}>{siteName}</a>
        <p class="flex items-center gap-2">
          <span aria-hidden="true">/</span>
          <a href={`${base}projects/`}>Projects</a>
          <span aria-hidden="true">/</span>
          <a href={`${base}#about`}>About Me</a>
        </p>
      </nav>
    </header>

    <main class="flex-1 px-6">
      <slot />
    </main>

    <footer class="px-6 py-4">
      <p class="mx-auto max-w-5xl">&copy; {new Date().getFullYear()} {siteName}</p>
    </footer>
  </body>
</html>
